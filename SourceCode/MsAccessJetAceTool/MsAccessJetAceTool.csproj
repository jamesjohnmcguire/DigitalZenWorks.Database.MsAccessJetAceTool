<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AnalysisMode>All</AnalysisMode>
		<AssemblyTitle>MsAccessJetAceTool</AssemblyTitle>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<Copyright>Copyright © 2006 - 2026 James John McGuire</Copyright>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<FileVersion>1.2.0</FileVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NeutralLanguage>en</NeutralLanguage>
		<NoWarn>NU1701</NoWarn>
		<OutputType>Exe</OutputType>
		<ProjectGuid>{774D5C5E-83A1-48CA-A51B-2A303528C7AB}</ProjectGuid>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Version>1.2.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Common.Logging" Version="3.4.1" />
		<PackageReference Include="Common.Logging.Core" Version="3.4.1" />
		<PackageReference Include="Common.Logging.Serilog" Version="5.1.0" />
		<PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="StyleCop.Analyzers" Version="1.3.177-beta">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Prefer the database checkout beside the active solution. -->
		<DatabaseToolKitProject Condition="'$(DatabaseToolKitProject)' == '' and&#xA;			'$(SolutionDir)' != '' and&#xA;			Exists('$(SolutionDir)Database.ToolKit/DatabaseLibraryNet/DigitalZenWorks.Database.ToolKit.csproj')">$(SolutionDir)Database.ToolKit/DatabaseLibraryNet/DigitalZenWorks.Database.ToolKit.csproj</DatabaseToolKitProject>

		<!-- Direct project builds use the standalone dependency. -->
		<DatabaseToolKitProject Condition="'$(DatabaseToolKitProject)' == ''">$(MSBuildThisFileDirectory)../Database.ToolKit/DatabaseLibraryNet/DigitalZenWorks.Database.ToolKit.csproj</DatabaseToolKitProject>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(DatabaseToolKitProject)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MsAccessJetAceTool.Tests" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="../stylecop.json" />
	</ItemGroup>

</Project>
